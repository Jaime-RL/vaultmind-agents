# Copia este fichero a .env y rellena tus valores. El .env NUNCA se sube al repo.

# --- Proveedor de modelos (API compatible con OpenAI: OpenRouter, Groq...) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Modelo pequeño (SLM) y modelo grande que usa SmartRoute
SLM_MODEL=qwen/qwen-2.5-7b-instruct
LARGE_MODEL=qwen/qwen-2.5-72b-instruct

# Alternativa GRATUITA (la que usa la URL pública): Groq sin tarjeta, solo con límites diarios.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# SLM_MODEL=openai/gpt-oss-20b
# LARGE_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# SLM_PRICE_INPUT=0.075
# SLM_PRICE_OUTPUT=0.30
# LARGE_PRICE_INPUT=0.15
# LARGE_PRICE_OUTPUT=0.60

# Solo para modelos de razonamiento (gpt-oss): low | medium | high. Vacío = no se envía.
LLM_REASONING_EFFORT=

# Precios en USD por millón de tokens (entrada / salida), publicados en OpenRouter
# para Qwen2.5 7B y 72B Instruct (consultados el 21-11-2026).
SLM_PRICE_INPUT=0.10
SLM_PRICE_OUTPUT=0.20
LARGE_PRICE_INPUT=0.36
LARGE_PRICE_OUTPUT=0.40

# --- Bóveda de Obsidian ---
# Sin definir = la bóveda de demostración del repo (demo-vault/).
# Para usar la tuya en local, descomenta y pon su ruta ABSOLUTA:
# VAULT_PATH=/home/usuario/Obsidian/MiBoveda

# --- Base de datos (trazas, investigaciones y propuestas) ---
# Sin definir = data/vaultmind.db en la raíz del repo. Para otra ubicación, ruta ABSOLUTA:
# DATABASE_PATH=/ruta/a/vaultmind.db

# --- Modo demo (URL pública) ---
# true = reproduce una investigación grabada: no necesita clave ni gasta saldo.
DEMO_MODE=false
DEMO_SPEED=1.0

# --- Límites de la API pública ---
MAX_CONCURRENT_RUNS=3
# Cupo de investigaciones reales por día (UTC), en total y por IP. 0 = sin límite.
MAX_RUNS_PER_DAY=10
MAX_RUNS_PER_IP_PER_DAY=3
# Sin clave o con el cupo agotado, reproducir la demo en lugar de dar error.
DEMO_FALLBACK=true
# URL pública: cada visitante (cookie anónima) ve y resuelve solo sus propuestas, y lo que
# aprueba se guarda solo para él, sin escribir en la bóveda compartida. En local, false.
PUBLIC_MODE=false
FINISHED_RUN_RETENTION_S=300

# --- Docker (docker compose) ---
# Carpeta del host que se monta como bóveda. Sin definir = ./demo-vault.
# VAULT_DIR=/home/usuario/Obsidian/MiBoveda

# --- Frontend ---
# Vacío = el frontend llama a /api en su mismo origen (Vite lo reenvía en desarrollo;
# en producción FastAPI sirve el frontend). Solo para apuntar a un backend en otro origen.
VITE_API_URL=
# Adónde reenvía Vite las peticiones /api en desarrollo (docker compose usa http://backend:8000).
# VITE_PROXY_TARGET=http://localhost:8000
# true = Vite sondea los ficheros (si la recarga no funciona con carpetas montadas desde Windows/macOS).
# VITE_USE_POLLING=false

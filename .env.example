# Copia este fichero a .env y rellena tus valores. El .env NUNCA se sube al repo.

# --- Proveedor de modelos (API compatible con OpenAI: OpenRouter, Groq...) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=

# Modelo pequeño (SLM) y modelo grande que usa SmartRoute
SLM_MODEL=
LARGE_MODEL=

# --- Bóveda de Obsidian ---
# Por defecto, la bóveda de demostración del repo. En local puedes apuntar a la tuya.
VAULT_PATH=./demo-vault

# --- Base de datos (trazas, investigaciones y propuestas) ---
DATABASE_PATH=./data/vaultmind.db

# --- Docker (docker compose) ---
# Carpeta del host que se monta como bóveda. Sin definir = ./demo-vault.
# VAULT_DIR=/home/usuario/Obsidian/MiBoveda

# --- Frontend ---
# Vacío = el frontend llama a /api en su mismo origen (Vite lo reenvía en desarrollo;
# en producción FastAPI sirve el frontend). Solo para apuntar a un backend en otro origen.
VITE_API_URL=
# Adónde reenvía Vite las peticiones /api en desarrollo (docker compose usa http://backend:8000).
# VITE_PROXY_TARGET=http://localhost:8000
# true = el frontend reproduce fixtures/run_example.jsonl en lugar de llamar al backend.
VITE_USE_MOCKS=false
# true = Vite sondea los ficheros (si la recarga no funciona con carpetas montadas desde Windows/macOS).
# VITE_USE_POLLING=false

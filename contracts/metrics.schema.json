{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metrics.schema.json",
  "title": "Metrics",
  "description": "GET /api/metrics (opcional ?run_id=...) — qué modelo hizo cada tarea, cuánto costó y el ahorro total. Costes en USD, que es como facturan los proveedores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks", "totals"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "agent", "task", "model", "tier", "prompt_tokens", "completion_tokens", "cost_usd", "latency_ms", "escalated"],
        "properties": {
          "run_id": { "type": "string" },
          "agent": { "type": "string", "enum": ["explorer", "researcher", "writer", "reviewer", "system"] },
          "task": { "type": "string" },
          "model": { "type": "string" },
          "tier": { "type": "string", "enum": ["slm", "large"] },
          "prompt_tokens": { "type": "integer", "minimum": 0 },
          "completion_tokens": { "type": "integer", "minimum": 0 },
          "cost_usd": { "type": "number", "minimum": 0 },
          "latency_ms": { "type": "number", "minimum": 0 },
          "escalated": { "type": "boolean" }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "cost_usd", "baseline_cost_usd", "savings_usd", "escalations", "slm_share"],
      "properties": {
        "tasks": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "baseline_cost_usd": { "type": "number", "minimum": 0, "description": "Coste estimado si todo lo hubiera hecho el modelo grande." },
        "savings_usd": { "type": "number" },
        "escalations": { "type": "integer", "minimum": 0 },
        "slm_share": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fracción de tareas resueltas por el SLM." }
      }
    }
  }
}

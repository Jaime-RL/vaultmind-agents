{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research.schema.json",
  "title": "Research",
  "description": "POST /api/research — lanza una investigación.",
  "$defs": {
    "ResearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic"],
      "properties": {
        "topic": { "type": "string", "minLength": 3, "maxLength": 200 },
        "language": {
          "description": "Idioma de las notas. auto (por defecto) = el idioma en que está escrito el tema.",
          "$ref": "#/$defs/ContentLanguage"
        },
        "ui_language": {
          "description": "Idioma de la interfaz: el de los mensajes de los agentes. Por defecto, es.",
          "$ref": "#/$defs/Language"
        }
      }
    },
    "Language": { "type": "string", "enum": ["es", "en", "fr", "de", "pt"] },
    "ContentLanguage": { "type": "string", "enum": ["auto", "es", "en", "fr", "de", "pt"] },
    "ResearchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id"],
      "properties": {
        "run_id": { "type": "string", "description": "Identificador para seguir los eventos en /api/research/{run_id}/events." }
      }
    }
  }
}
